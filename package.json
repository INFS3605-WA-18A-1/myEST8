{
  "name": "myest8",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run check",
    "check": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "css": "tailwindcss -i src/web/tailwind.css -o src/web/static/tw.css --minify",
    "css:watch": "tailwindcss -i src/web/tailwind.css -o src/web/static/tw.css --watch",
    "dev": "tsx scripts/db.ts start --quiet && npm run css --silent && (npm run css:watch --silent & DATABASE_SCHEMA=dev tsx watch src/demo/main.ts)",
    "dev:reset": "tsx scripts/db.ts reset",
    "demo": "tsx scripts/db.ts start --quiet && npm run css --silent && tsx src/demo/main.ts",
    "start": "tsx src/main.ts",
    "prod:local": "tsx scripts/prod-local.ts",
    "test:e2e:prod-local": "playwright test -c playwright.prod-local.config.ts",
    "db:start": "tsx scripts/db.ts start",
    "db:stop": "tsx scripts/db.ts stop",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:reset": "tsx scripts/db.ts reset",
    "screenshots": "tsx scripts/screenshot.ts",
    "smoke:live": "tsx scripts/smoke-live.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@hono/node-server": "^2.1.4",
    "@phosphor-icons/core": "^2.1.1",
    "@vercel/functions": "^3.10.4",
    "daisyui": "^5.7.50",
    "exifr": "^7.1.3",
    "hono": "^4.13.13",
    "maplibre-gl": "^6.15.0",
    "postgres": "^3.4.9",
    "read-excel-file": "9.3.10",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.20.5",
    "playwright": "^1.64.1",
    "supabase": "^2.122.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vercel": "64.2.0",
    "vitest": "^5.0.5",
    "write-excel-file": "4.1.1"
  }
}
