{
  "name": "myest8",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run check",
    "check": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "dev": "tsx scripts/db.ts start --quiet && DATABASE_SCHEMA=dev tsx watch src/demo/main.ts",
    "dev:reset": "tsx scripts/db.ts reset",
    "demo": "tsx scripts/db.ts start --quiet && tsx src/demo/main.ts",
    "db:start": "tsx scripts/db.ts start",
    "db:stop": "tsx scripts/db.ts stop",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:reset": "tsx scripts/db.ts reset",
    "screenshots": "tsx scripts/screenshot.ts",
    "smoke:live": "tsx scripts/smoke-live.ts"
  },
  "dependencies": {
    "@fontsource/lexend": "^5.3.0",
    "@fontsource/red-hat-text": "^5.3.0",
    "@hono/node-server": "^2.1.4",
    "@phosphor-icons/core": "^2.1.1",
    "@tailwindcss/browser": "^4.3.3",
    "daisyui": "^5.7.47",
    "exifr": "^7.1.3",
    "hono": "^4.13.13",
    "leaflet": "^1.9.4",
    "postgres": "^3.4.9",
    "read-excel-file": "9.3.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "playwright": "^1.64.0",
    "supabase": "^2.120.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "write-excel-file": "4.1.1"
  }
}
