{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": false },
  "regions": ["icn1"],
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "{src/web/static/**,src/demo/sample-photos/**,node_modules/{daisyui/**,maplibre-gl/{package.json,dist/maplibre-gl{,-worker}.mjs,dist/maplibre-gl.css},@fontsource-variable/{bricolage-grotesque,public-sans}/**,@phosphor-icons/core/assets/**}}"
    }
  },
  "crons": [{ "path": "/api/cron/worker", "schedule": "0 6 * * *" }]
}
