# Environment variables myEST8 reads. Copy to .env (git-ignored) and fill in only
# what you need. Nothing loads this file automatically; export the values
# in your shell (for example `set -a; . ./.env; set +a`) before `npm run dev`.
# Never commit real values. The Resend and Anthropic lines below are commented out
# (placeholders re_xxx, whsec_xxx, sk-ant-xxx, not keys): uncomment and fill them
# in only to use those providers. Every empty value stays mocked.

# --- Server and data ---
# Port the demo listens on (default 3000).
PORT=4000
# Public base URL used in links sent to Tenants and Tradies (default http://localhost:$PORT).
PUBLIC_URL=
# Postgres schema the demo keeps its data in across restarts. Empty = a fresh
# throwaway schema each start, dropped on exit. `npm run dev` uses "dev".
DATABASE_SCHEMA=
# "empty" starts the demo with just the Agency; anything else plays the demo stories on first seed.
DEMO_DATA=

# --- Jev classifies every inbound message: kind, Urgency, Trade, replies (ADR 0011); empty = in-process mock ---
JEV_API_URL=
JEV_API_KEY=

# --- Photo matcher; empty = in-process mock ---
VISION_API_URL=
VISION_API_KEY=

# --- Quote reader; empty = in-process mock ---
QUOTES_API_URL=
QUOTES_API_KEY=

# --- Google Places and Geocoding; empty = in-process mock ---
GOOGLE_MAPS_API_KEY=

# --- Dispatch map tiles: CARTO Positron with this key; empty = Esri's keyless World Light Gray Base ---
# Free, no account: request one at https://carto.com/basemaps/apikey (CARTO serves no tiles without a key).
CARTO_BASEMAPS_KEY=

# --- Real messages. Empty = simulated only (the phone simulator) under `npm run demo`
# and `npm run dev` (src/demo/main.ts). Those commands never fill DEMO_SEND_TO, so a
# configured provider still does not deliver. `npm start` (src/main.ts) sets
# DEMO_SEND_TO to * when this is empty, so delivery is real. ---
# Comma-separated phone numbers and emails that may really be messaged ("*" = anyone).
# The seeded people's numbers are made up and could belong to real people.
DEMO_SEND_TO=

# --- Running for real: `npm start` (src/main.ts) ---
# npm start needs an https PUBLIC_URL (your Cloudflare Tunnel hostname), keeps data in
# DATABASE_SCHEMA (default "myest8"; deploy/serve.sh sets "live") and messages anyone
# unless DEMO_SEND_TO is set. It refuses to start with any API on a mock unless ALLOW_MOCKS=1.
ALLOW_MOCKS=

# --- Resend email (ADR 0006). All three, or none. Placeholders, not keys. ---
# Domain: a subdomain such as mail.kevinhe.pro, with the MX, SPF and DKIM records
# Resend shows. Webhook: $PUBLIC_URL/webhooks/resend, event email.received.
# See docs/channels-setup.md.
# RESEND_API_KEY=re_xxx
# RESEND_WEBHOOK_SECRET=whsec_xxx
# RESEND_INBOUND_DOMAIN=mail.kevinhe.pro

# --- Claude Haiku composes outbound messages and writes the Summary (ADR 0011). Not built yet:
# today it also classifies whenever this is set, ahead of Jev. ---
# ANTHROPIC_API_KEY=sk-ant-xxx

# --- Gmail is dormant (ADR 0006). The code still reads these. Both client values, or neither;
# both also require TOKEN_ENCRYPTION_KEY. Not read: GOOGLE_OAUTH_*, CHANNEL_SECRET_KEY. ---
# Google Cloud: enable the Gmail API, create an OAuth client (Web application) with the
# redirect URI $PUBLIC_URL/oauth/google/callback, keep the consent screen in Testing and
# add each Gmail account that will connect as a test user.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64 (`openssl rand -base64 32`): encrypts stored Gmail refresh tokens.
TOKEN_ENCRYPTION_KEY=

# --- WhatsApp through Meta's WhatsApp Cloud API ---
# Phone number id and access token: both or neither. Not read: WHATSAPP_TOKEN and the other WHATSAPP_* names.
# Meta for Developers: an app with the WhatsApp product. API Setup shows the test number's
# Phone number ID and lets you add up to 5 recipient phones.
META_WHATSAPP_PHONE_NUMBER_ID=
# The test number itself in E.164 (e.g. +15550000000), shown on the channels page.
META_WHATSAPP_NUMBER=
# A system user access token (Business settings); the API Setup page's temporary one lasts hours.
META_WHATSAPP_ACCESS_TOKEN=
# App settings > Basic > App secret: checks the signature on /webhooks/whatsapp.
# Both this and the verify token, or the webhook route stays off.
META_APP_SECRET=
# Any random string; enter the same one as the Verify token when you add the webhook
# $PUBLIC_URL/webhooks/whatsapp in Meta (subscribe to the "messages" field).
META_WEBHOOK_VERIFY_TOKEN=

# --- The older Twilio and SendGrid route (still read; Resend is the email path, ADR 0006) ---
# Secret that signs the expiring /media/:id links Twilio fetches attachments from.
# Required with Twilio, along with a PUBLIC_URL Twilio can reach (https). At least
# 32 characters, e.g. `openssl rand -base64 48`; the same on every server.
FILE_LINK_SECRET=

# --- Twilio SMS (and WhatsApp only when the Meta pair above is unset) ---
# One shared number. A number bought per Agency is not built: TWILIO_BUNDLE_SID and
# TWILIO_ADDRESS_SID are not read (ADR 0005).
# Account SID (AC...) and auth token: both or neither. The token also checks /webhooks/twilio.
# Both also require FILE_LINK_SECRET and an https PUBLIC_URL.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Required once the Twilio pair is set (the app refuses to start without it): the Twilio number (E.164) every SMS is sent from.
TWILIO_SMS_FROM=
# Optional: send WhatsApp from this number (E.164, no "whatsapp:"). Without it Twilio sends no WhatsApp. Unused while Meta is set.
TWILIO_WHATSAPP_FROM=

# --- SendGrid email (v3 Mail Send, and Inbound Parse for replies) ---
# API key with Mail Send permission.
SENDGRID_API_KEY=
# Optional: send every email from this address on a SendGrid-verified domain instead of the
# Agency's inbox address. Replies still go to the Agency's inbox (reply-to).
SENDGRID_FROM=
# Inbound Parse signature verification key (base64), checked on /webhooks/sendgrid.
SENDGRID_INBOUND_PUBLIC_KEY=

# --- Database: Supabase Postgres (see docs/testing.md) ---
# Postgres connection string for this environment's database. Never the production one outside
# production. A production server refuses to start without it (src/db.ts requireDatabaseUrl).
# Empty = the local Postgres from `npm run db:start` (Docker), postgres://postgres:postgres@127.0.0.1:54340/myest8,
# which `npm run dev` and `npm run demo` use. The demo applies migrations itself, so it only runs
# on a local Postgres; hosted databases get them from the Supabase CLI (`supabase db push`).
# Behind Supabase's transaction pooler (port 6543) prepared statements are turned off automatically.
SUPABASE_DB_URL=
# Project URL, e.g. https://<project-ref>.supabase.co. Not used by the app yet. Use a different project or branch per environment.
SUPABASE_URL=
# Postgres server the tests make their throwaway databases on (vitest and Playwright). Empty = the
# local Docker one above (started if need be). CI sets it to its Postgres service. Never a hosted database.
TEST_DATABASE_URL=

# --- Hosted on Vercel + Supabase (docs/vercel.md). Set these in Vercel, not here. ---
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DATABASE_SCHEMA=public
# DB_POOL_MAX=2
# PUBLIC_URL=https://your-production-domain
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service role key; server only, never in the browser>
# CRON_SECRET=<random string; the same value in the GitHub secret CRON_SECRET>

# Non-local SUPABASE_DB_URL connects with TLS required (sslmode=require/verify-* in the URL is honoured); on the :6543 pooler DATABASE_SCHEMA must stay public.
