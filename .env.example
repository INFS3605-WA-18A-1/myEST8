# Environment variables myEST8 reads. Copy to .env (git-ignored) and fill in only
# what you need: with everything empty the demo runs fully offline, with every
# external API mocked. Nothing loads this file automatically; export the values
# in your shell (for example `set -a; . ./.env; set +a`) before `npm run dev`.
# Never commit real values.

# --- Server and data ---
# Port the demo listens on (default 3000).
PORT=4000
# Public base URL used in links sent to Tenants and Tradies (default http://localhost:$PORT).
PUBLIC_URL=
# Postgres schema the demo keeps its data in across restarts. Empty = a fresh
# throwaway schema each start, dropped on exit. `npm run dev` uses "dev".
DATABASE_SCHEMA=
# "empty" starts the demo with just the Agency; anything else plays the demo stories on first seed.
DEMO_DATA=

# --- Jev classifier (Urgency, Trade); empty = in-process mock ---
JEV_API_URL=
JEV_API_KEY=

# --- Photo matcher; empty = in-process mock ---
VISION_API_URL=
VISION_API_KEY=

# --- Quote reader; empty = in-process mock ---
QUOTES_API_URL=
QUOTES_API_KEY=

# --- Google Places and Geocoding; empty = in-process mock ---
GOOGLE_MAPS_API_KEY=

# --- Real messages. Empty = simulated only (the phone simulator). Set, the demo
# really sends on that provider's channels, but only to the addresses in DEMO_SEND_TO. ---
# Comma-separated phone numbers and emails the demo may really message ("*" = anyone).
# The seeded people's numbers are made up and could belong to real people.
DEMO_SEND_TO=
# Secret that signs the expiring /media/:id links Twilio fetches attachments from.
# Required with Twilio, along with a PUBLIC_URL Twilio can reach (https). At least
# 32 characters, e.g. `openssl rand -base64 48`; the same on every server.
FILE_LINK_SECRET=

# --- Twilio SMS and WhatsApp (Programmable Messaging) ---
# Account SID (AC...) and auth token. The token also checks the signature on /webhooks/twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional: send every SMS from this Twilio number (E.164) instead of the Agency's connected SMS number.
TWILIO_SMS_FROM=
# Optional: send every WhatsApp message from this number (E.164, no "whatsapp:"), e.g. the sandbox's +14155238886.
TWILIO_WHATSAPP_FROM=

# --- SendGrid email (v3 Mail Send, and Inbound Parse for replies) ---
# API key with Mail Send permission.
SENDGRID_API_KEY=
# Optional: send every email from this address on a SendGrid-verified domain instead of the
# Agency's inbox address. Replies still go to the Agency's inbox (reply-to).
SENDGRID_FROM=
# Inbound Parse signature verification key (base64), checked on /webhooks/sendgrid.
SENDGRID_INBOUND_PUBLIC_KEY=

# --- Database: Supabase Postgres (see docs/testing.md) ---
# Postgres connection string for this environment's database. Never the production one outside
# production. A production server refuses to start without it (src/db.ts requireDatabaseUrl).
# Empty = the local Postgres from `npm run db:start` (Docker), postgres://postgres:postgres@127.0.0.1:54340/myest8,
# which `npm run dev` and `npm run demo` use. The demo applies migrations itself, so it only runs
# on a local Postgres; hosted databases get them from the Supabase CLI (`supabase db push`).
# Behind Supabase's transaction pooler (port 6543) prepared statements are turned off automatically.
SUPABASE_DB_URL=
# Project URL, e.g. https://<project-ref>.supabase.co. Not used by the app yet. Use a different project or branch per environment.
SUPABASE_URL=
# Postgres server the tests make their throwaway databases on (vitest and Playwright). Empty = the
# local Docker one above (started if need be). CI sets it to its Postgres service. Never a hosted database.
TEST_DATABASE_URL=
