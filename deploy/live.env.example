# Copy to ~/.config/myest8/live.env, `chmod 600`, and replace every placeholder.
# The systemd service loads this file. See docs/channels-setup.md and docs/hosting.md.
# Names the process does not read, and that must not be revived here:
# GOOGLE_OAUTH_CLIENT_ID, GOOGLE_OAUTH_CLIENT_SECRET, CHANNEL_SECRET_KEY,
# WHATSAPP_TOKEN, WHATSAPP_APP_SECRET, WHATSAPP_VERIFY_TOKEN,
# WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_DISPLAY_NUMBER.

# The address people and providers reach the app at. src/main.ts requires https.
PUBLIC_URL=https://myest8.example.com

# 1 = start even when classifier, places, or a channel is still mocked.
# Unset, src/main.ts exits and names the mocks.
ALLOW_MOCKS=
# Comma-separated addresses that may really be messaged. Unset, src/main.ts uses *
# (anyone). src/demo/main.ts does not: an empty list there only simulates.
DEMO_SEND_TO=

# Email through Resend (all three, or none). Placeholders, not keys.
RESEND_API_KEY=re_xxx
RESEND_WEBHOOK_SECRET=whsec_xxx
RESEND_INBOUND_DOMAIN=mail.kevinhe.pro

# Claude Haiku composes outbound messages and writes the Summary; Jev (JEV_API_URL, JEV_API_KEY
# below) classifies inbound ones (ADR 0011). Not built yet: today Haiku also classifies whenever this is set.
ANTHROPIC_API_KEY=sk-ant-xxx

# Gmail OAuth is dormant (ADR 0006). Read only if you set both client values,
# which also requires TOKEN_ENCRYPTION_KEY (openssl rand -base64 32).
# TOKEN_ENCRYPTION_KEY also turns on Agency SMS numbers (see the SMS block below) and
# encrypts the Twilio details an Agency registers. Losing it means they paste them again.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=

# WhatsApp Cloud API. Phone number id and access token: both or neither.
# App secret and verify token: both, or /webhooks/whatsapp stays off.
META_WHATSAPP_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_NUMBER=

# SMS through textbee (ADR 0013): one Android phone for the server. All four, or none.
# TEXTBEE_NUMBER is the phone's number, E.164 (for example +61412345678).
# TEXTBEE_WEBHOOK_SECRET signs /webhooks/textbee (20 characters or more).
# TEXTBEE_API_URL is optional and overrides https://api.textbee.dev (a fake in tests).
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_NUMBER=
TEXTBEE_WEBHOOK_SECRET=
TEXTBEE_API_URL=

# SMS through Twilio is switched off while textbee is set (ADR 0013).
# Each Agency gets its own Twilio number (ADR 0005), once TOKEN_ENCRYPTION_KEY is set.
# Account SID and auth token: both or neither, and then FILE_LINK_SECRET plus PUBLIC_URL.
# The account has to be upgraded from trial.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# For "Create a new number": an approved Australian mobile regulatory bundle (BU...) and an
# address (AD...) on that account. `npx tsx scripts/twilio-setup.ts` finds both. Unset, that
# button is disabled and "Register a Twilio number" still works.
TWILIO_BUNDLE_SID=
TWILIO_ADDRESS_SID=
# Optional with TOKEN_ENCRYPTION_KEY: one shared number for an Agency with none of its own.
# Required without it, and then every SMS comes from it.
TWILIO_SMS_FROM=
FILE_LINK_SECRET=

# Optional. Empty stays mocked, which needs ALLOW_MOCKS=1 under src/main.ts.
# GOOGLE_MAPS_API_KEY needs only the Places API (New). It no longer geocodes.
GOOGLE_MAPS_API_KEY=
# Optional, no key needed: the Nominatim that places addresses on the Dispatch map (ADR 0012).
# Default https://nominatim.openstreetmap.org, which allows one request a second.
NOMINATIM_URL=
# Optional, no key needed: Photon suggests addresses while a Property's address is typed (ADR 0012).
# Default https://photon.komoot.io. Nominatim's usage policy forbids search-as-you-type.
PHOTON_URL=
JEV_API_URL=
JEV_API_KEY=
VISION_API_URL=
VISION_API_KEY=
QUOTES_API_URL=
QUOTES_API_KEY=

# Older email path, still read when SENDGRID_API_KEY is set. Resend is the one to configure.
SENDGRID_API_KEY=
SENDGRID_FROM=
SENDGRID_INBOUND_PUBLIC_KEY=
