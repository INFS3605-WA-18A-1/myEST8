# Copy to ~/.config/myest8/live.env, `chmod 600`, and fill in what you want to be real.
# The systemd service loads it. Everything left empty stays simulated. See docs/channels-setup.md.

# The address people and providers reach the app at. Required for real Gmail and WhatsApp.
PUBLIC_URL=https://myest8.example.com

# Gmail (all three, or none)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# openssl rand -base64 32  (keep a copy: losing it means every Agency reconnects Gmail)
CHANNEL_SECRET_KEY=

# WhatsApp Cloud API (all five, or none)
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DISPLAY_NUMBER=

# SMS: a Twilio number bought for each Agency (paid account and an approved Australian bundle; docs/channels-setup.md section 3)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_BUNDLE_SID=
TWILIO_ADDRESS_SID=
FILE_LINK_SECRET=

# Optional
GOOGLE_MAPS_API_KEY=
