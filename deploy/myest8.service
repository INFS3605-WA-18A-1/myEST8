[Unit]
Description=myEST8 live app (src/main.ts, schema "live")
After=network-online.target docker.service

[Service]
WorkingDirectory=%h/apps/myEST8
# Channel keys and PUBLIC_URL (docs/channels-setup.md). src/main.ts exits while any API is mocked unless this file sets ALLOW_MOCKS=1.
EnvironmentFile=-%h/.config/myest8/live.env
ExecStart=%h/apps/myEST8/deploy/serve.sh
Restart=on-failure
RestartSec=5
# Let the app finish in-flight requests and drop its connections on stop.
TimeoutStopSec=15

# Started by the quick tunnel's unit. With the named tunnel, enable this unit too.
[Install]
WantedBy=default.target
