# Copy to ~/.config/myest8/qa.env, `chmod 600`, and fill in every value. Never commit that
# file or paste it anywhere: this repository is public. The QA service (myest8-qa.service),
# deploy/qa-exec.sh and so the QA workflow all read it. See docs/qa.md and ADR 0011.
#
# QA has its own everything: its own address, its own Resend account, its own Postgres
# schema (`qa`, set by the unit and by qa-exec.sh, not here) and its own test Gmail account.
# Nothing here may be copied from live.env. In particular do NOT set SUPABASE_DB_URL,
# SUPABASE_URL or SUPABASE_SERVICE_ROLE_KEY: QA keeps its data in the local Postgres and
# serve.sh refuses to start QA with the Supabase ones.

# --- The QA app ---

# The QA tunnel hostname (deploy/cloudflared.yml). One label under your domain, starting
# "qa-", so Cloudflare's free certificate covers it and the email journey can tell it from
# production. https, no trailing slash.
PUBLIC_URL=

# Must be 1: file storage, photo matching, quote reading and maps are not part of the email
# test and stay on the in-process mocks.
ALLOW_MOCKS=1

# The only address QA may really email: the test Gmail account (QA_GMAIL_ADDRESS below).
# Any other address is recorded in the phone simulator and not sent, so QA can never mail a
# real person, even if someone adds one to its data.
DEMO_SEND_TO=

# --- Email through Resend: QA's own free account, domain and webhook ---
# The free plan allows one webhook endpoint per team and counts sent and received mail
# against 100 a day, so QA can't share the production team (ADR 0011).

# An API key from the QA Resend account with Full access: reading a received email needs it.
RESEND_API_KEY=
# The signing secret (whsec_...) of the webhook to https://<PUBLIC_URL>/webhooks/resend, event email.received.
RESEND_WEBHOOK_SECRET=
# QA's inbound subdomain on the QA Resend account, no "@" or scheme, such as qa-mail.example.com.
# Not production's mail.<domain>: the journey refuses that.
RESEND_INBOUND_DOMAIN=

# --- The classifier ---

# Claude Haiku is the real classifier when this is set (a few cents a night). Leave it empty
# to use the free in-process classifier: the journey then proves everything but Claude's
# reading of the email.
ANTHROPIC_API_KEY=

# --- The QA Agency (scripts/qa-seed.ts creates it, scripts/qa-email-journey.ts signs in as it) ---

# The QA Property Manager's sign-in. The password only ever opens the QA app: make one up from
# letters and digits (`openssl rand -hex 16`), because systemd and the shell read quotes and
# symbols in this file differently. No quotes anywhere in the file.
QA_PM_EMAIL=
QA_PM_PASSWORD=
# The Agency's inbox, which the journey emails: any name on RESEND_INBOUND_DOMAIN, such as qa@qa-mail.example.com.
QA_INBOUND_ADDRESS=

# --- The test Gmail account: the Tenant in the journey (docs/qa.md, steps 1 and 2) ---

QA_GMAIL_ADDRESS=
# From the OAuth client you create, and the refresh token `npx tsx scripts/qa-gmail-token.ts` prints.
QA_GMAIL_CLIENT_ID=
QA_GMAIL_CLIENT_SECRET=
QA_GMAIL_REFRESH_TOKEN=
